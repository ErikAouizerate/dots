# Mir's own configuration (MirRunner reads $XDG_CONFIG_HOME/miracle-wm.config,
# a separate file from miracle-wm/config.yaml; long-form key=value entries).
#
# ext_data_control_manager_v1: without it, the clipboard history of the
# DankMaterialShell bar cannot start. DMS is an ext-data-control client, and
# clipman, cliphist and `wl-paste --watch` all speak wlr-data-control, which
# Mir does not implement. miracle-wm 0.8.x never enables the ext protocol by
# itself, although Mir supports it.
add-wayland-extensions=ext_data_control_manager_v1
