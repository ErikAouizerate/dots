{
  "go.formatTool": "gofmt",
  "go.lintOnSave": "package",
  "go.vetOnSave": "package",
  "editor.inertialScroll": true,
  "eslint.useFlatConfig": true,
  "eslint.options": {
    "overrideConfigFile": "./eslint.config.mts", // Change path if needed
  },
  "[go]": {
    "editor.formatOnSave": true,
  },
  "editor.formatOnSave": true, // Tell VSCode to format files on save
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit",
      "source.fixAll.yamllint": "explicit",
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit",
      "source.fixAll.yamllint": "explicit",
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit",
      "source.fixAll.yamllint": "explicit",
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "eslint.nodePath": "./node_modules/eslint",
  "ansibleVault.executable": "/usr/bin/ansible-vault",
  "workbench.startupEditor": "newUntitledFile",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "files.associations": {
    ".env.sample": "env",
    "*plays.yml": "ansible",
    "*init.yml": "yaml",
  },
  "typescript.updateImportsOnFileMove.enabled": "never",
  "colorize.languages": ["javascript", "css"],
  "debug.javascript.autoAttachFilter": "disabled",
  "git.ignoreMissingGitWarning": true,
  "security.workspace.trust.untrustedFiles": "open",
  "search.exclude": {
    "**/node_modules": true,
    "**/env": true,
    "**/venv": true,
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/env/**": true,
    "**/venv/**": true,
    "env-*": true,
  },
  "typescript.disableAutomaticTypeAcquisition": true,
  "editor.suggest.preview": true,
  "editor.wordWrap": "on",
  "eslint.codeActionsOnSave.rules": null,
  "cSpell.language": "fr",
  "css.lint.unknownAtRules": "ignore",
  "[python]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
    },
  },
  "editor.inlineSuggest.enabled": true,
  "workbench.editor.empty.hint": "hidden",
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": false,
  "gitlens.hovers.enabled": false,
  "explorer.confirmPasteNative": false,
  "prisma.showPrismaDataPlatformNotification": false,
  "settingsSync.ignoredExtensions": [],
  "settingsSync.ignoredSettings": [],
  "redhat.telemetry.enabled": true,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": false,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "repositories": false,
    "searchAndCompare": false,
    "launchpad": false,
  },
  "gitlab.duoCodeSuggestions.enabled": false,
  "gitlab.duoChat.enabled": false,
  "gitlab.duo.enabledWithoutGitlabProject": false,
  "github.copilot.chat.codeGeneration.instructions": [],
  "svelte.enable-ts-plugin": true,
  "diffEditor.codeLens": true,
  "geminicodeassist.inlineSuggestions.enableAuto": false,
  "python.analysis.typeCheckingMode": "standard",
  "docker.extension.enableComposeLanguageServer": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "chat.disableAIFeatures": true,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "go.toolsManagement.autoUpdate": true,
  "claudeCode.preferredLocation": "panel",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "git.blame.editorDecoration.enabled": true,
}
